options:
  parameters:
    author: gpsk_comms
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Standalone sweep (chirp) jammer for two 100 MHz bands: 2392-2492
      MHz and 5190-5290 MHz. A linear chirp sweeps across the instantaneous sample_rate
      window while the embedded block steps the USRP LO across each band and alternates
      between the two, covering the full 2 x 100 MHz. Speed and sample rate are live
      sliders. WARNING: this transmits -- only radiate in bands you are licensed for,
      into a load or attenuator. Both default bands overlap licensed services.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: sweep_jammer
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Sweep Jammer - two 100 MHz bands
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: antenna
  id: variable
  parameters:
    comment: ''
    value: '"TX/RX"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 204]
    rotation: 0
    state: enabled
- name: bands
  id: variable_qtgui_chooser
  parameters:
    comment: Which allocation(s) to sweep. Changing this rebuilds the LO plan live.
    gui_hint: 0,0,1,2
    label: Band(s) to jam
    label0: 2.4 GHz ISM (2392-2492 MHz)
    label1: 5.2 GHz (5190-5290 MHz)
    label2: Both bands
    label3: 5210 MHz only (single channel)
    label4: ''
    labels: '[]'
    num_opts: '4'
    option0: '"2g4"'
    option1: '"5g2"'
    option2: '"both"'
    option3: '"5210"'
    option4: '4'
    options: '[0, 1, 2, 3]'
    orient: Qt.QVBoxLayout
    type: string
    value: '"2g4"'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [776, 84]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: Initial LO frequency, set before the flowgraph starts. The embedded block
      retunes the radio from here via command messages, so this only needs to be a
      frequency the daughterboard can reach.
    value: '2442000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 204]
    rotation: 0
    state: enabled
- name: device_addr
  id: variable
  parameters:
    comment: Empty takes the first device found; set a serial to pick one.
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 204]
    rotation: 0
    state: enabled
- name: dwell
  id: variable_qtgui_range
  parameters:
    comment: Seconds the LO holds on each step before moving on. The full band revisit
      time is dwell times the number of LO steps. Live.
    gui_hint: 2,0,1,1
    label: LO dwell (s)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0.005'
    step: '0.005'
    stop: '0.2'
    value: '0.02'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 84]
    rotation: 0
    state: enabled
- name: gain
  id: variable_qtgui_range
  parameters:
    comment: USRP transmit gain in dB. Live. Start low.
    gui_hint: 2,1,1,1
    label: TX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '100'
    value: '95'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [584, 84]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable_qtgui_range
  parameters:
    comment: Instantaneous swept bandwidth, and the USRP sample rate. Live, though
      a real radio may glitch as it retunes its clocks -- for a jammer that does not
      matter. Keep it inside what your device and USB/Ethernet link can sustain.
    gui_hint: 1,0,1,1
    label: Sample rate (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1000000'
    step: '1000000'
    stop: '10000000'
    value: '5000000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 84]
    rotation: 0
    state: enabled
- name: speed
  id: variable_qtgui_range
  parameters:
    comment: Chirp sweeps per second across the sample_rate window. Higher dwells
      less on each frequency; lower puts more energy per visit. Live.
    gui_hint: 1,1,1,1
    label: Sweep speed (sweeps/s)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1'
    step: '1'
    stop: '100'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 84]
    rotation: 0
    state: enabled
- name: chirp
  id: epy_block
  parameters:
    _source_code: "\"\"\"Chirp sweep jammer with LO stepping across two 100 MHz bands.\n\
      \nA linear chirp is generated across +/- samp_rate/2. The block also steps the\n\
      USRP local oscillator by publishing 'freq' command messages on its message\n\
      port; wire that port to a UHD Sink's command port and the LO tiles each band\n\
      and alternates between them, covering far more spectrum than one sample_rate\n\
      window. Sample rate, speed, dwell and band selection are all live: work()\n\
      rebuilds the LO plan whenever the sample rate or band selection changes.\n\"\
      \"\"\n\nimport math\nimport time\n\nimport numpy as np\nimport pmt\nfrom gnuradio\
      \ import gr\n\n# The two target bands as (low_hz, high_hz), matching the anti-jam\
      \ link's\n# 2442 MHz and 5240 MHz allocations.\n_BANDS = {\n    \"2g4\": [(2_392_000_000,\
      \ 2_492_000_000)],\n    \"5g2\": [(5_190_000_000, 5_290_000_000)],\n    \"both\"\
      : [(2_392_000_000, 2_492_000_000), (5_190_000_000, 5_290_000_000)],\n    \"5210\": [(5_210_000_000, 5_210_000_000)],\n}\n\n\n\
      class blk(gr.sync_block):\n    def __init__(self, samp_rate=20e6, speed=1000.0,\
      \ dwell=0.02, bands=\"both\"):\n        gr.sync_block.__init__(\n          \
      \  self, name=\"Chirp Sweep Jammer\", in_sig=None,\n            out_sig=[np.complex64],\n\
      \        )\n        self.samp_rate = float(samp_rate)\n        self.speed =\
      \ float(speed)\n        self.dwell = float(dwell)\n        self.bands = bands\n\
      \        self.message_port_register_out(pmt.intern(\"command\"))\n        self._count\
      \ = 0\n        self._phase = 0.0\n        self._index = 0\n        self._next_step\
      \ = 0.0\n        self._built_for = None\n        self._plan = [2_442_000_000.0]\n\
      \        # The first real plan build and LO tune happen in start(), once the\n\
      \        # command port is connected -- publishing here would go nowhere.\n\n\
      \    # A live QT control writes straight to the attribute (GRC generates\n \
      \   # e.g. self.chirp.samp_rate = ...), so no setters are needed: work()\n \
      \   # reads speed and dwell fresh each call, and rebuilds the LO plan\n    #\
      \ whenever samp_rate or bands no longer match what it built for.\n    def _rebuild_plan(self):\n\
      \        centres = []\n        for low, high in _BANDS.get(self.bands, _BANDS[\"\
      both\"]):\n            width = high - low\n            steps = max(1, math.ceil(width\
      \ / self.samp_rate))\n            step_width = width / steps\n            for\
      \ k in range(steps):\n                centres.append(low + step_width * (k +\
      \ 0.5))\n        self._plan = centres\n        self._index = 0\n        self._built_for\
      \ = (self.samp_rate, self.bands)\n        self._retune(self._plan[0])\n    \
      \    self._next_step = time.monotonic() + self.dwell\n\n    def _retune(self,\
      \ freq):\n        # Print the current centre frequency on every LO step, so\
      \ the\n        # console shows the sweep walking across the bands.\n       \
      \ print(\"[sweep jammer] centre frequency -> %.3f MHz\" % (freq / 1e6),\n  \
      \            flush=True)\n        self.message_port_pub(\n            pmt.intern(\"\
      command\"),\n            pmt.cons(pmt.intern(\"freq\"), pmt.from_double(float(freq))),\n\
      \        )\n\n    def start(self):\n        self._rebuild_plan()\n        return\
      \ True\n\n    def work(self, input_items, output_items):\n        if (self.samp_rate,\
      \ self.bands) != self._built_for:\n            self._rebuild_plan()\n\n    \
      \    out = output_items[0]\n        n = len(out)\n        period = max(2.0,\
      \ self.samp_rate / self.speed)\n        idx = self._count + np.arange(n)\n \
      \       inst = (idx % period) / period - 0.5\n        phase = self._phase +\
      \ 2.0 * np.pi * np.cumsum(inst)\n        out[:] = np.exp(1j * phase).astype(np.complex64)\n\
      \        self._phase = float(phase[-1] % (2.0 * np.pi))\n        self._count\
      \ += n\n\n        if len(self._plan) > 1 and time.monotonic() >= self._next_step:\n\
      \            self._index = (self._index + 1) % len(self._plan)\n           \
      \ self._retune(self._plan[self._index])\n            self._next_step = time.monotonic()\
      \ + self.dwell\n        return n\n"
    affinity: ''
    alias: ''
    bands: bands
    comment: Generates the chirp and, on its command port, the LO retune messages
      that tile both bands. Wire command -> USRP Sink command.
    dwell: dwell
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    speed: speed
  states:
    _io_cache: ('Chirp Sweep Jammer', 'blk', [('samp_rate', '20000000.0'), ('speed',
      '1000.0'), ('dwell', '0.02'), ('bands', "'both'")], [], [('0', 'complex', 1),
      ('command', 'message', 1)], '', ['bands', 'dwell', 'samp_rate', 'speed'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 356]
    rotation: 0
    state: enabled
