options:
  parameters:
    author: gpsk_comms
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Capture stage of the replay attack. Records complex baseband IQ
      from a USRP to a file (cf32 / gr_complex) so replay_attack.grc can transmit it
      back. Centre frequency, sample rate and the target band (2392-2492 MHz or
      5190-5290 MHz) are live sliders. Press Record to start writing to the file and
      release it to stop; the file is truncated each time the flowgraph starts.
      Capture at the same sample rate you intend to replay at, then run
      replay_attack.grc pointing at the same file.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: replay_capture
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Replay Capture - record IQ to file
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: band
  id: variable_qtgui_chooser
  parameters:
    comment: 'Target allocation. Each option is a (low_hz, high_hz) tuple; the
      centre-frequency slider spans whichever band is selected here. Switching band
      while running snaps the radio to that band''s centre frequency. NOTE: the
      slider''s min/max endpoints are fixed when the flowgraph starts, so to slide
      freely across the other band, restart after changing this.'
    gui_hint: 0,0,1,2
    label: Target band
    num_opts: '2'
    orient: Qt.QVBoxLayout
    type: raw
    value: (2392e6, 2492e6)
    widget: combo_box
    option0: (2392e6, 2492e6)
    label0: 2.4 GHz (2392-2492 MHz)
    option1: (5190e6, 5290e6)
    label1: 5.2 GHz (5190-5290 MHz)
    options: '[]'
    labels: '[]'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [8, 84]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable_qtgui_range
  parameters:
    comment: USRP receive centre frequency, in Hz. The slider spans the band chosen
      above. Live within the band.
    gui_hint: 1,0,1,2
    label: Centre frequency (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: band[0]
    step: '1000000'
    stop: band[1]
    value: (band[0] + band[1]) / 2
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [200, 84]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable_qtgui_range
  parameters:
    comment: USRP sample rate, in Hz. Record at the same rate you plan to replay at.
      Live.
    gui_hint: 2,0,1,1
    label: Sample rate (Hz)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '1000000'
    step: '1000000'
    stop: '56000000'
    value: '20000000'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [392, 84]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: USRP receive gain in dB. Live.
    gui_hint: 2,1,1,1
    label: RX gain (dB)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '76'
    value: '40'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [584, 84]
    rotation: 0
    state: enabled
- name: record
  id: variable_qtgui_check_box
  parameters:
    comment: Tick to write samples to the file; untick to stop. The file is truncated
      when the flowgraph starts, so tick this only once you are on the signal.
    'false': 'False'
    gui_hint: 3,0,1,2
    label: Record to file
    'true': 'True'
    type: bool
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [776, 84]
    rotation: 0
    state: enabled
- name: capture_file
  id: variable
  parameters:
    comment: Path the recording is written to. Point replay_attack.grc at this same
      file to transmit it back.
    value: '"/tmp/capture.cf32"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [8, 204]
    rotation: 0
    state: enabled
- name: device_addr
  id: variable
  parameters:
    comment: Empty takes the first device found; set a serial to pick one.
    value: '""'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [200, 204]
    rotation: 0
    state: enabled
- name: usrp_source
  id: uhd_usrp_source
  parameters:
    affinity: ''
    alias: ''
    ant0: '"TX/RX"'
    bw0: samp_rate
    center_freq0: center_freq
    clock_rate: 0e0
    clock_source0: ''
    comment: ''
    dev_addr: device_addr
    dev_args: ''
    gain0: rx_gain
    gain_type0: default
    maxoutbuf: '0'
    minoutbuf: '0'
    nchan: '1'
    num_mboards: '1'
    otw: ''
    samp_rate: samp_rate
    start_time: '-1.0'
    stream_args: ''
    stream_chans: '[]'
    sync: sync
    time_source0: ''
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [8, 332]
    rotation: 0
    state: enabled
- name: record_valve
  id: blocks_copy
  parameters:
    affinity: ''
    alias: ''
    comment: Passes samples through only while Record is ticked, gating what reaches
      the file.
    enabled: record
    maxoutbuf: '0'
    minoutbuf: '0'
    showports: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [280, 348]
    rotation: 0
    state: enabled
- name: file_sink
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: The captured recording. Truncated at start; written to while Record is
      ticked.
    file: capture_file
    type: complex
    unbuffered: 'True'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [536, 348]
    rotation: 0
    state: enabled
- name: spectrum
  id: qtgui_freq_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    autoscale: 'False'
    average: '0.1'
    axislabels: 'True'
    bw: samp_rate
    color1: '"blue"'
    color10: '"dark blue"'
    color2: '"red"'
    color3: '"green"'
    color4: '"black"'
    color5: '"cyan"'
    color6: '"magenta"'
    color7: '"yellow"'
    color8: '"dark red"'
    color9: '"dark green"'
    comment: Live receive spectrum, so you can see the signal before recording it.
    ctrlpanel: 'False'
    fc: center_freq
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'True'
    gui_hint: 4,0,1,1
    label: Relative Gain
    label1: rx
    label10: ''''''
    label2: ''''''
    label3: ''''''
    label4: ''''''
    label5: ''''''
    label6: ''''''
    label7: ''''''
    label8: ''''''
    label9: ''''''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Receive spectrum"'
    nconnections: '1'
    norm_window: 'False'
    showports: 'False'
    tr_chan: '0'
    tr_level: '0.0'
    tr_mode: qtgui.TRIG_MODE_FREE
    tr_tag: '""'
    type: complex
    units: dB
    update_time: '0.10'
    width1: '1'
    width10: '1'
    width2: '1'
    width3: '1'
    width4: '1'
    width5: '1'
    width6: '1'
    width7: '1'
    width8: '1'
    width9: '1'
    wintype: window.WIN_BLACKMAN_hARRIS
    ymax: '10'
    ymin: '-110'
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [280, 500]
    rotation: 0
    state: enabled
- name: waterfall
  id: qtgui_waterfall_sink_x
  parameters:
    affinity: ''
    alias: ''
    alpha1: '1.0'
    alpha10: '1.0'
    alpha2: '1.0'
    alpha3: '1.0'
    alpha4: '1.0'
    alpha5: '1.0'
    alpha6: '1.0'
    alpha7: '1.0'
    alpha8: '1.0'
    alpha9: '1.0'
    axislabels: 'True'
    bw: samp_rate
    color1: '0'
    color10: '0'
    color2: '0'
    color3: '0'
    color4: '0'
    color5: '0'
    color6: '0'
    color7: '0'
    color8: '0'
    color9: '0'
    comment: Receive signal over time.
    fc: center_freq
    fftsize: '1024'
    freqhalf: 'True'
    grid: 'False'
    gui_hint: 4,1,1,1
    int_max: '10'
    int_min: '-110'
    label1: ''
    label10: ''
    label2: ''
    label3: ''
    label4: ''
    label5: ''
    label6: ''
    label7: ''
    label8: ''
    label9: ''
    legend: 'True'
    maxoutbuf: '0'
    minoutbuf: '0'
    name: '"Receive over time"'
    nconnections: '1'
    showports: 'False'
    type: complex
    update_time: '0.10'
    wintype: window.WIN_BLACKMAN_hARRIS
  states:
    bus_sink: false
    bus_source: false
    bus_structure:
    coordinate: [280, 660]
    rotation: 0
    state: enabled

connections:
- [usrp_source, '0', record_valve, '0']
- [usrp_source, '0', spectrum, '0']
- [usrp_source, '0', waterfall, '0']
- [record_valve, '0', file_sink, '0']

metadata:
  file_format: 1
  grc_version: 3.10.10.0
