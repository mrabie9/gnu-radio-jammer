options:
  parameters:
    author: gpsk_comms
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Anti-jam command link loopback with a switchable jammer, no USRP
      hardware
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: aj_command_loopback
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: AJ Command Loopback
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: jam_amplitude
  id: variable
  parameters:
    comment: ''
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [464, 12]
    rotation: 0
    state: enabled
- name: master_key
  id: variable
  parameters:
    comment: ''
    value: generate_master_key()
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [624, 12]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: spreading_factor
  id: variable
  parameters:
    comment: ''
    value: '255'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 12]
    rotation: 0
    state: enabled
- name: combiner
  id: blocks_add_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_inputs: '2'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [568, 200.0]
    rotation: 0
    state: enabled
- name: command_debug
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'True'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1144, 192.0]
    rotation: 0
    state: enabled
- name: command_strobe
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.dict_add(pmt.make_dict(), pmt.intern("command"), pmt.intern("forward"))
    period: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 328.0]
    rotation: 0
    state: enabled
- name: import_key
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: from gpsk_comms.security import generate_master_key, load_master_key
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [168, 88.0]
    rotation: 0
    state: enabled
- name: jammer
  id: analog_sig_source_x
  parameters:
    affinity: ''
    alias: ''
    amp: jam_amplitude
    comment: ''
    freq: samp_rate*0.13
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '0'
    phase: '0'
    samp_rate: samp_rate
    showports: 'False'
    type: complex
    waveform: analog.GR_COS_WAVE
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 408.0]
    rotation: 0
    state: enabled
- name: rx
  id: gpsk_comms_aj_command_rx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    detection_threshold: '0.25'
    dwell_us: '100000'
    excision_enabled: 'True'
    grace_period: '0.0'
    hopping_enabled: 'False'
    interleave_depth: '17'
    master_key: master_key
    maxoutbuf: '0'
    minoutbuf: '0'
    sample_rate: samp_rate
    spreading_factor: spreading_factor
    watchdog_timeout: '1.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [824, 156.0]
    rotation: 0
    state: enabled
- name: throttle
  id: blocks_throttle2
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    ignoretag: 'True'
    limit: auto
    maximum: '0.1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samples_per_second: samp_rate
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [664, 200.0]
    rotation: 0
    state: enabled
- name: tx
  id: gpsk_comms_aj_command_tx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    dwell_us: '100000'
    hold_to_send: 'False'
    hopping_enabled: 'False'
    interleave_depth: '17'
    master_key: master_key
    maxoutbuf: '0'
    minoutbuf: '0'
    repeat_rate: '20'
    sample_rate: samp_rate
    spreading_factor: spreading_factor
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 152.0]
    rotation: 0
    state: enabled

connections:
- [combiner, '0', throttle, '0']
- [command_strobe, strobe, tx, command]
- [jammer, '0', combiner, '1']
- [rx, command, command_debug, print]
- [throttle, '0', rx, '0']
- [tx, '0', combiner, '0']

metadata:
  file_format: 1
  grc_version: 3.10.10.0
